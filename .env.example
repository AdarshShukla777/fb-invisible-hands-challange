# Copy to .env (never commit .env). main.py picks the provider:
#   uv run python main.py               -> local vLLM (no key needed)
#   uv run python main.py --gemini      -> GEMINI_API_KEY or GOOGLE_API_KEY
#   uv run python main.py --anthropic   -> ANTHROPIC_API_KEY
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Credentials used by tests as {{secret:NAME}} placeholders, e.g. {{secret:HRM_PASSWORD}}
# UITEST_SECRET_HRM_PASSWORD=
